+# Image types served from a run's artifacts dir. No svg — it can carry
+# same-origin script when navigated to directly.
+_ARTIFACT_IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".gif"}
+
+
+def _run_artifacts(run_id: str) -> list[dict]:
+    """Image-gallery sections declared by a run's ``artifacts/index.json``.
+
+    An agent may drop image files plus an ``index.json``
+    (``{"sections": [{"title", "items": [{"file", "caption"}]}]}``) into
+    ``$AGENTHUB_RUN_DIR/artifacts/``. Only hub-validated data reaches the
+    template: filenames must be plain basenames of existing image files under
+    the run's artifacts dir, and agent strings (title/caption) are emitted only
+    through Jinja auto-escaping — the ``<img>`` markup and its ``src`` are
+    hub-generated, so the "renderer never emits a tag derived from agent
+    content" invariant is preserved.
+    """
+    root = get_settings().runs_dir / run_id / "artifacts"
+    try:
+        data = json.loads((root / "index.json").read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return []
+    sections: list[dict] = []
+    for sec in data.get("sections", []) if isinstance(data, dict) else []:
+        if not isinstance(sec, dict):
+            continue
+        items: list[dict] = []
+        for it in sec.get("items", []):
+            if not isinstance(it, dict):
+                continue
+            name = it.get("file")
+            if (
+                not isinstance(name, str)
+                or not name
+                or "/" in name
+                or "\\" in name
+                or name.startswith(".")
+            ):
+                continue
+            if Path(name).suffix.lower() not in _ARTIFACT_IMAGE_SUFFIXES:
+                continue
+            if not (root / name).is_file():
+                continue
+            items.append({"file": name, "caption": str(it.get("caption", ""))})
+        if items:
+            sections.append({"title": str(sec.get("title", "")), "items": items})
+    return sections
+
+
