+{# Per-run artifact image gallery (agents that produce visual reports, e.g.
+   a2ui-dali-release).
+
+   SECURITY: `artifacts` comes from views._run_artifacts(), which parses the
+   agent-written artifacts/index.json and keeps only plain-basename filenames of
+   EXISTING image files under the run's artifacts dir. Agent strings
+   (title/caption/filename) are emitted ONLY via Jinja auto-escaping; the <img>
+   tag and its src are hub-generated markup served by the authed
+   /runs/{id}/artifacts/{file} route — the escape-first invariant ("never emit a
+   tag derived from agent content") holds. #}
+{% if artifacts %}
+<div class="artifact-gallery">
+  <style>
+    .artifact-gallery .ag-title { margin: 14px 0 8px; font-size: 1em; }
+    .artifact-gallery .ag-grid { display: flex; flex-wrap: wrap; gap: 12px; }
+    .artifact-gallery figure { margin: 0; max-width: 100%; }
+    .artifact-gallery img { max-width: 100%; height: auto; border: 1px solid rgba(127,127,127,.35); border-radius: 6px; background: #fff; }
+    .artifact-gallery figcaption { font-size: .85em; opacity: .75; margin-top: 4px; max-width: 480px; }
+  </style>
+  {% for sec in artifacts %}
+  <h3 class="ag-title">{{ sec.title }}</h3>
+  <div class="ag-grid">
+    {% for it in sec['items'] %}
+    <figure>
+      <a href="/runs/{{ run.id }}/artifacts/{{ it.file }}" target="_blank" rel="noopener">
+        <img loading="lazy" src="/runs/{{ run.id }}/artifacts/{{ it.file }}" alt="{{ it.caption }}">
+      </a>
+      <figcaption>{{ it.caption }}</figcaption>
+    </figure>
+    {% endfor %}
+  </div>
+  {% endfor %}
+</div>
+{% endif %}
