diff --git a/tests/smoke/test_run_artifacts.py b/tests/smoke/test_run_artifacts.py
new file mode 100644
index 0000000..48a5a60
--- /dev/null
+++ b/tests/smoke/test_run_artifacts.py
@@ -0,0 +1,105 @@
+"""Per-run artifact image gallery: index.json validation + authed file route."""
+
+from __future__ import annotations
+
+import json
+
+from agenthub.config import get_settings
+from agenthub.db import SessionLocal
+from agenthub.models import Agent, Run, _utcnow
+
+# 1x1 red PNG
+_PNG = bytes.fromhex(
+    "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de"
+    "0000000c4944415408d763f8cfc000000301010018dd8db00000000049454e44ae426082"
+)
+
+
+def _run_with_artifacts(index: dict | None, files: dict[str, bytes]) -> str:
+    with SessionLocal() as s:
+        if s.get(Agent, "echo") is None:
+            s.add(Agent(id="echo", name="Echo", version="0.0.0", manifest_path="-"))
+        run = Run(
+            agent_id="echo", status="succeeded", params={}, created_by="op@x", finished_at=_utcnow()
+        )
+        s.add(run)
+        s.commit()
+        rid = run.id
+    d = get_settings().runs_dir / rid / "artifacts"
+    d.mkdir(parents=True, exist_ok=True)
+    if index is not None:
+        (d / "index.json").write_text(json.dumps(index), encoding="utf-8")
+    for name, data in files.items():
+        (d / name).write_bytes(data)
+    return rid
+
+
+def test_artifact_route_serves_image(client):
+    rid = _run_with_artifacts(None, {"sheet.png": _PNG})
+    r = client.get(f"/runs/{rid}/artifacts/sheet.png")
+    assert r.status_code == 200
+    assert r.content == _PNG
+
+
+def test_artifact_route_404s(client):
+    rid = _run_with_artifacts(None, {"sheet.png": _PNG, "notes.txt": b"secret"})
+    # unknown run / missing file / non-image suffix
+    assert client.get("/runs/nope-xyz/artifacts/sheet.png").status_code == 404
+    assert client.get(f"/runs/{rid}/artifacts/absent.png").status_code == 404
+    assert client.get(f"/runs/{rid}/artifacts/notes.txt").status_code == 404
+
+
+def test_artifact_route_blocks_traversal(client):
+    rid = _run_with_artifacts(None, {"sheet.png": _PNG})
+    # run.log lives one level above artifacts/ — must not be reachable
+    (get_settings().runs_dir / rid / "run.log").write_text("secret", encoding="utf-8")
+    for path in ("../run.log", "..%2frun.log", "%2e%2e/run.log"):
+        r = client.get(f"/runs/{rid}/artifacts/{path}")
+        assert r.status_code in (404, 400), path
+        assert b"secret" not in r.content
+
+
+def test_gallery_rendered_on_run_page_and_fragment(client):
+    rid = _run_with_artifacts(
+        {
+            "sections": [
+                {
+                    "title": "갤러리 요약 시트",
+                    "items": [
+                        {"file": "sheet.png", "caption": "36종 렌더"},
+                        # invalid entries must be dropped, not rendered
+                        {"file": "../run.log", "caption": "traversal"},
+                        {"file": "absent.png", "caption": "missing"},
+                        {"file": "notes.txt", "caption": "not an image"},
+                    ],
+                }
+            ]
+        },
+        {"sheet.png": _PNG, "notes.txt": b"x"},
+    )
+    for url in (f"/runs/{rid}", f"/runs/{rid}/result-card"):
+        body = client.get(url).text
+        assert f"/runs/{rid}/artifacts/sheet.png" in body, url
+        assert "갤러리 요약 시트" in body, url
+        # invalid entries dropped: no artifact link other than sheet.png
+        assert "artifacts/.." not in body, url
+        assert "absent.png" not in body, url
+        assert "notes.txt" not in body, url
+
+
+def test_gallery_absent_without_index(client):
+    rid = _run_with_artifacts(None, {"sheet.png": _PNG})
+    body = client.get(f"/runs/{rid}").text
+    assert "artifact-gallery" not in body
+
+
+def test_index_caption_is_escaped(client):
+    rid = _run_with_artifacts(
+        {"sections": [{"title": "<script>alert(1)</script>",
+                       "items": [{"file": "sheet.png",
+                                  "caption": "<img src=x onerror=alert(1)>"}]}]},
+        {"sheet.png": _PNG},
+    )
+    body = client.get(f"/runs/{rid}").text
+    assert "<script>alert(1)</script>" not in body
+    assert "<img src=x" not in body
