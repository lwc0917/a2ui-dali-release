# a2ui-dali-release 설정 — 복사해서 .env 로 (gitignored).
# 모든 키는 생략 가능 — automation/lib/load_env.sh 의 기본값이 쓰인다.

# ── 릴리스 대상 ────────────────────────────────────────────────
# push 권한 있는 remote (호스트의 기존 SSH 키 사용)
#A2UI_GIT_REMOTE=git@github.com:dalihub/a2ui-dali.git
# 릴리스 커밋 author/committer (반드시 사용자 본인)
#GIT_RELEASE_NAME=woochan lee
#GIT_RELEASE_EMAIL=lwcc0917@gmail.com

# ── 업스트림 소스 ──────────────────────────────────────────────
#DALI_UI_REPO=https://github.com/dalihub/dali-ui.git
#DALI_CORE_REPO=https://github.com/dalihub/dali-core.git
#DALI_ADAPTOR_REPO=https://github.com/dalihub/dali-adaptor.git

# ── 게이트 ────────────────────────────────────────────────────
#RENDER_W=480
#RENDER_H=1280
#RENDER_WAIT=5
#DIFF_THRESHOLD=0.05     # mean-abs-diff — 이하는 AA 노이즈로 간주(PASS)
#MAX_FIX_ATTEMPTS=3      # Claude 코드 적응 루프 상한 (빌드+컨포먼스 합산)

# ── Claude 에스컬레이션 ───────────────────────────────────────
#CLAUDE_MODEL=opus
#CLAUDE_TIMEOUT=900      # 헤드리스 1콜 wall-clock 상한(초)

# ── 실행 모드 ─────────────────────────────────────────────────
#DRY_RUN=0               # 1 = 커밋/태그/push/베이스라인 회전/ledger 기록 생략
#FORCE_TARGET=           # 지정 시 ledger 무시하고 해당 dali-ui 태그를 재처리 (예: v2.5.28.10837)
#FORCE_REBUILD=0         # 1 = 스택/렌더러 클린 재빌드
#JOBS=                   # make -j 값 (기본 nproc)
